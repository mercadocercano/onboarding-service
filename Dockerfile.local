# syntax=docker/dockerfile:1
# Dockerfile.local - Build usando libs locales para go-shared (sin GITHUB_TOKEN
# para esa dependencia). github.com/mercadocercano/eventbus SÍ es privado y
# requiere el BuildKit secret github_token (mismo patrón que sales-service/tenant-service).
# Ejecutar desde la raíz del repo: docker build -f services/onboarding-service/Dockerfile.local .

FROM golang:1.25-bookworm AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copiar go.mod/go.sum + lib local primero (cache de capas: separar deps de source)
COPY services/onboarding-service/go.mod services/onboarding-service/go.sum* ./
COPY libs/go-shared ./libs/go-shared/

# Usar lib local en lugar de GitHub (evita GITHUB_TOKEN para go-shared)
RUN echo 'replace github.com/hornosg/go-shared => ./libs/go-shared' >> go.mod

# github.com/mercadocercano/eventbus SÍ es un módulo privado real (sin lib local
# equivalente) — el token llega como BuildKit secret y nunca queda en una capa.
ENV GOPRIVATE=github.com/mercadocercano/*
RUN --mount=type=secret,id=github_token \
    if [ -s /run/secrets/github_token ]; then \
      git config --global url."https://$(cat /run/secrets/github_token)@github.com/".insteadOf "https://github.com/"; \
    fi && \
    go mod download && \
    rm -f /root/.gitconfig

# Ahora sí, el resto del código fuente del servicio (pisa el go.mod de arriba con el
# original sin el replace — se vuelve a aplicar acá, el mod cache de la capa anterior
# sigue siendo válido)
COPY services/onboarding-service/ ./
COPY libs/go-shared ./libs/go-shared/
RUN grep -q 'replace github.com/hornosg/go-shared' go.mod || \
    echo 'replace github.com/hornosg/go-shared => ./libs/go-shared' >> go.mod

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main ./src/main.go

# Final stage
FROM debian:bookworm-slim

ARG APP_VERSION=1.0
ARG APP_PORT=8110
ARG APP_ENV=development

LABEL maintainer="SaaS Team" \
      application="onboarding" \
      version="${APP_VERSION}" \
      description="Multi-tenant Onboarding service" \
      environment="${APP_ENV}"

ENV PORT=${APP_PORT} \
    APP_ENV=${APP_ENV}

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata wget \
    && rm -rf /var/lib/apt/lists/* \
    && (cp /usr/share/zoneinfo/UTC /etc/localtime || true) && \
    echo "UTC" > /etc/timezone && \
    useradd -r -m appuser

WORKDIR /app

COPY --from=builder /app/main .
COPY --from=builder /app/migrations ./migrations

RUN chmod +x /app/main && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:${PORT}/health || exit 1

CMD ["./main"]
