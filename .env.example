# Onboarding Service — Environment Variables

# Server
PORT=8110
ENVIRONMENT=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
# RULE-09 / RULE-10 (PLAT-E28): el runtime corre SIEMPRE bajo el rol de aplicación least-privilege
# onboarding_app (NOBYPASSRLS) — NUNCA como postgres/superuser, que bypasearía la RLS de
# onboarding_processes y verification_codes (FORCE ROW LEVEL SECURITY no aplica a superusers →
# RLS "activa" pero nunca ejercida, sirviendo PII de email + códigos de verificación cross-tenant
# en el momento del alta). El rol se crea con migrations/roles/onboarding_app.sql. La password se
# fija out-of-band (`ALTER ROLE onboarding_app PASSWORD '...'`) y NUNCA se commitea; el valor de
# abajo es solo el default de dev local (docker-compose raíz usa
# ${ONBOARDING_DB_PASSWORD:-onboarding_app123} — flip del compose en T7).
DB_USER=onboarding_app
DB_PASSWORD=onboarding_app123
DB_NAME=onboarding_db
DB_SSLMODE=disable

# Service identity
SERVICE_NAMESPACE=mc
SYSTEM_TENANT_ID=123e4567-e89b-12d3-a456-426614174003

# External services (Kong entrypoint by default)
IAM_SERVICE_URL=http://lab-kong:8000/iam-service
PIM_SERVICE_URL=http://lab-kong:8000/pim-service
TENANT_SERVICE_URL=http://lab-kong:8000/tenant-service
NOTIFICATION_SERVICE_URL=http://lab-kong:8000/notifications/api/v1

# S2S auth
# Preferred: scoped key registered in IAM for service "onboarding".
# Must have at least 16 bytes; 32+ bytes hex recommended.
S2S_KEY_ONBOARDING=
# Legacy fallback god-key. Used only if S2S_KEY_ONBOARDING is empty.
S2S_API_KEY=

# JWT service-token auth (legacy fallback when S2S keys are not configured)
JWT_SECRET=
IAM_SUPER_ADMIN_TOKEN=

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=2116

# Timeouts (seconds)
HTTP_CLIENT_TIMEOUT=30
DB_CONNECTION_TIMEOUT=10

# EventBus (event-driven welcome email)
EVENTBUS_ENABLED=false
EVENTBUS_DB_HOST=localhost
EVENTBUS_DB_PORT=5432
EVENTBUS_DB_USER=postgres
EVENTBUS_DB_PASSWORD=postgres
EVENTBUS_DB_NAME=eventbus
EVENTBUS_DB_SSL_MODE=disable

# Testing / verification bypass
TESTING_MODE=false
BYPASS_EMAIL_VERIFICATION=false
